# ──────────────────────────────────────────────────────────────────────
# Hermes Trading Bot — Environment Variables
# ──────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your keys:
#   cp .env.example .env
#
# The bot reads these via os.Getenv(). Never commit .env to version control.
# ──────────────────────────────────────────────────────────────────────

# ── Bybit API (Required for market data + trading) ─────────────────────
# Create API keys at: https://www.bybit.com/app/user/api-management
# Required permissions: Read (data) + Trade / Contract (order execution)
BYBIT_API_KEY=""
BYBIT_API_SECRET=""

# ── Bybit WebSocket (Optional — used by the Listener daemon) ───────────
# Defaults to wss://stream.bybit.com/v5/private if not set.
BYBIT_WS_URL=""

# ── Telegram Alerts (Optional — real-time trade & snapshot alerts) ──────
# Create a bot via @BotFather and get your chat ID from @userinfobot.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# ── OpenRouter AI Gateway (Required for AI signal verification) ────────
# Get a key at: https://openrouter.ai/keys
# Used to validate every BUY/SELL signal before execution.
# No cost on HOLD signals — only calls the API on actionable entries.
OPENROUTER_API_KEY=""
